<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".AvaliacaoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="45dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_avaliacao_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto de perfil"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_avatar" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_avaliacao_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Avalie a aula"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat"
            android:text="Sua nota"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp" />

        <RatingBar
            android:id="@+id/rating_bar_nota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:numStars="5"
            android:progressBackgroundTint="#32FFB703"
            android:stepSize="0.5"
            android:theme="@style/RatingBarTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_comentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Deixe um comentário (opcional)"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enviar_avaliacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingVertical="14dp"
            android:text="Enviar Avaliação" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>