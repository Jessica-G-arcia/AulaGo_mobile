<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="184dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="139dp"
                android:layout_gravity="top"
                android:scaleType="fitXY"
                android:src="@drawable/capa_blue" />

            <LinearLayout
                android:id="@+id/groupRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProfessorRatingMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/azul"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="4.8" />

                <RatingBar
                    android:id="@+id/rbProfessorRating"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:progressTint="@color/amarelo"
                    tools:rating="4.8" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="35dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Avatar"
                android:elevation="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_avatar_circle"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="16dp"
                android:text="Contratar Professor"
                android:textColor="@color/azul"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/hand_shake"
                app:iconSize="20dp"
                app:iconTint="@color/azul" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/inputNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="Carregando nome..."
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusProfessor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="✓"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:chipBackgroundColor="#4CAF50"
                        app:chipEndPadding="8dp"
                        app:chipMinHeight="28dp"
                        app:chipStartPadding="8dp"
                        app:chipStrokeWidth="0dp"
                        tools:visibility="visible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPlanoPro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="★"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/amarelo"
                        app:chipEndPadding="8dp"
                        app:chipMinHeight="28dp"
                        app:chipStartPadding="8dp"
                        app:chipStrokeWidth="0dp"
                        tools:visibility="visible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPlanoPremium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="👑"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/marinho"
                        app:chipEndPadding="6dp"
                        app:chipMinHeight="28dp"
                        app:chipStartPadding="6dp"
                        app:chipStrokeWidth="0dp"
                        tools:visibility="visible" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/inputEspecialidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_trophy"
                android:drawablePadding="10dp"
                android:fontFamily="@font/montserrat"
                android:gravity="center_vertical"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:visibility="visible"
                app:drawableTint="@color/azul"
                tools:text="Especialidade: Carregando" />

            <TextView
                android:id="@+id/inputModalidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="10dp"
                android:fontFamily="@font/montserrat"
                android:gravity="center_vertical"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="visible"
                app:drawableTint="@color/azul"
                tools:text="Modalidade: Presencial e Online" />

            <LinearLayout
                android:id="@+id/groupValorPresencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_presencial"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="Presencial: "
                    app:drawableTint="@color/azul" />

                <TextView
                    android:id="@+id/inputValorPresencial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="R$ 150,00" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupValorOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_online"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:text="Online: "
                    app:drawableTint="@color/azul" />

                <TextView
                    android:id="@+id/inputValorOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    tools:text="R$ 100,00" />

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:background="@android:color/transparent"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/sky"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/sky"
            app:tabTextAppearance="@style/MyCustomTabStyle">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sobre mim" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliações" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/groupBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:padding="20dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvBio"
                    style="@style/TextAppearance.AppCompat.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:fontFamily="@font/montserrat"
                    android:padding="16dp"
                    android:text='Pense na bio como a capa de trás de um livro 📖.
        É o resumo que faz o aluno pensar: "Uau, é disso que eu preciso!"'
                    android:textSize="14dp"
                    android:textStyle="italic" />

            </androidx.cardview.widget.CardView>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupAvaliacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="Ainda não há avaliações."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAvaliacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/review_card" />

        </LinearLayout>


    </LinearLayout>

</ScrollView>